# ==============================================================================
# School Examination Marks and Report Card Management System
# Production Environment Variable Contract (.env.example)
# Phase 6.10 — Environment Configuration & Deployment Readiness
# ==============================================================================
# SECURITY NOTICE:
# - NEVER commit production secrets, real passwords, or production APP_KEY to Git.
# - In production environments, set APP_ENV=production and APP_DEBUG=false.
# - All values below are non-secret defaults or architectural placeholders.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE CONFIGURATION
# ------------------------------------------------------------------------------
# Sensitivity: Public / Operational
APP_NAME="School Examination Marks and Report Card Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://school.example.com

# ------------------------------------------------------------------------------
# 2. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Sensitivity: Operational
# Options: stack, single, daily, stderr. Recommended production: daily
LOG_CHANNEL=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (POSTGRESQL 18.x)
# ------------------------------------------------------------------------------
# Sensitivity: HIGH (DB_PASSWORD is a confidential credential)
# Least Privilege: DB_USERNAME must be a dedicated DML application role (e.g. school_app_user).
# Superuser or DDL accounts MUST NOT be used by the web runtime.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=school_marks_db
DB_USERNAME=school_app_user
DB_PASSWORD=

# ------------------------------------------------------------------------------
# 4. SESSION & COOKIE SECURITY
# ------------------------------------------------------------------------------
# Sensitivity: Operational / Security
# Recommended production: SESSION_SECURE_COOKIE=true, SESSION_HTTP_ONLY=true
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ------------------------------------------------------------------------------
# 5. CACHE & QUEUE CONFIGURATION
# ------------------------------------------------------------------------------
# Sensitivity: Operational
# Baseline supports file-based caching and synchronous queue execution.
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ------------------------------------------------------------------------------
# 6. FILESYSTEM & PRIVATE REPORT STORAGE
# ------------------------------------------------------------------------------
# Sensitivity: Operational
# Canonical root for private reports defaults to storage_path('app/private').
# Reports are strictly private and NEVER exposed through public URLs or storage:link.
FILESYSTEM_DISK=local
# Optional custom root override for private_reports disk (leave blank for default):
# PRIVATE_REPORTS_DISK_ROOT=/var/app/private

# ------------------------------------------------------------------------------
# 7. PDF COMPILATION & BROWSER EXECUTION (BROWSER SHOT / CHROMIUM)
# ------------------------------------------------------------------------------
# Sensitivity: Operational
# Node.js and Chromium paths if non-standard or containerized.
# Leave blank to rely on system PATH discovery.
BROWSERSHOT_NODE_PATH=
BROWSERSHOT_NPM_PATH=
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_TIMEOUT=60

# ------------------------------------------------------------------------------
# 8. ASSET COMPILATION (VITE)
# ------------------------------------------------------------------------------
# Sensitivity: Public
# Only expose non-sensitive public variables to Vite.
VITE_APP_NAME="${APP_NAME}"
